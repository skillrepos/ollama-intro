{
    // Prebuilt image - see .devcontainer/Dockerfile and IMAGEMAINTENANCE.md.
    // Everything slow (OS packages, Node, Claude Code, the Python venv, the
    // Ollama binary, and BOTH workshop models) is already inside it.
    //
    // For a fork, or if the GHCR image is ever unavailable, comment out "image"
    // and uncomment "build" below. "context": ".." is required because the
    // Dockerfile COPYs requirements.txt from the repo root.
    "image": "ghcr.io/skillrepos/ollama-intro-devcontainer:latest",
    // "build": { "dockerfile": "Dockerfile", "context": ".." },

    "remoteEnv": {
        "OLLAMA_MODEL": "llama3.2:3b",
        "OLLAMA_HOST": "127.0.0.1:11434",
        // Matches the Dockerfile - the baked-in model store.
        "OLLAMA_MODELS": "/opt/ollama-models",
        "OLLAMA_KEEP_ALIVE": "-1"
    },

    // Ollama's API is the only port anyone needs. Ollama also spawns one
    // "runner" child process per loaded model, each on a random high port, and
    // VS Code auto-forwards those - so the PORTS panel fills up with entries
    // students have no use for, and stale ones survive codespace restarts.
    "forwardPorts": [11434],
    "portsAttributes": {
        "11434": { "label": "Ollama API", "onAutoForward": "silent" }
    },
    "otherPortsAttributes": { "onAutoForward": "ignore" },

    "hostRequirements": {
       "cpus": 4,
       "memory": "16gb",
       "storage": "32gb"
    },

    // No "features" block. Python and Node are installed in the Dockerfile.
    // docker-from-docker and github-cli were dropped outright - nothing in the
    // labs, README, or scripts uses docker or gh, and each feature added
    // minutes to every student's container build.

    "customizations": {
        "vscode": {
            "settings": {
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/py_env/bin/python",
                "github.copilot.enable": {
                  "*": false,
                  "plaintext": false,
                  "markdown": false,
                  "scminput": false
                 },
                 "github.copilot.enableAutoComplete": false,
                 "editor.inlineSuggest.enabled": false,
                 "github.copilot.inlineSuggest.enable": false,
                 "github.copilot.chat.enable": false,
                 "github.copilotChat.showInExplorer": false,
                 "workbench.startupEditor": "readme",
                 // Open Markdown files in preview mode by default
                 "workbench.editorAssociations": {
                     "*.md": "vscode.markdown.preview.editor"
                 },
                 "terminal.integrated.defaultProfile.linux": "bash",
                 "terminal.integrated.profiles.linux": {
                     "bash": { "path": "bash", "args": ["-l"] }
                 }
            }
        }
    },

    // What is left at create time: copy the prebuilt venv into the workspace,
    // start Ollama, and install the Merge Info extension. VS Code extensions
    // live in the server directory rather than the image, so that one cannot
    // be baked in. postCreate runs without an interactive terminal, so nothing
    // can interrupt it.
    "postCreateCommand": "bash -i scripts/pysetup.sh py_env && bash -i scripts/startup_ollama.sh; code --install-extension ${containerWorkspaceFolder}/.devcontainer/merge-info-0.1.0.vsix --force || true",

    // Detached on purpose: VS Code extensions (Python, Git) relaunch the
    // post-attach terminal and send a Ctrl+C, which kills anything running
    // in the foreground there. setsid+nohup puts this out of its reach.
    "postAttachCommand": "setsid nohup bash scripts/postattach.sh >/tmp/postattach.log 2>&1 </dev/null &"
}
